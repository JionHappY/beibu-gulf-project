# 仓库根环境变量示例（docker compose / 部署 preflight 读取；复制为 .env）
# 前端本地开发键见 frontend/.env.example；后端运行时键见 backend/.env.example。
# 已退役：VITE_API_BASE / VITE_DATA_SOURCE / VITE_USE_NEST_MODULES，勿再配置。

# 前端构建注入（docker-compose.yml 的 app.build.args 唯一读取的前端键）
VITE_TIANDITU_KEY=

# 镜像 tag（可选；CI 推送 ghcr 后按部署批次填写）
# IMAGE_TAG=

# 生产数据库口令（必填；未注入 compose 直接中断，禁止使用 postgres）
# POSTGRES_PASSWORD=<强口令>

# 无 TLS 本地逃生开关（preflight 读取；生产置 1 会明文传输 JWT）
ALLOW_INSECURE=0
